# Virtual environment
.venv/
venv/
ENV/

# Python caching
__pycache__/
*.py[cod]
*$py.class

# User configurations (private keys & tokens)
config/api_keys.json
config/google_token.json
config/certs/*.key
config/certs/*.crt


# Local databases and runtime state
memory/long_term.json
memory/__pycache__/
dashboard/__pycache__/
config/__pycache__/
actions/__pycache__/

# IDEs & System files
.vscode/
.idea/
.DS_Store
scratch/

# Secrets — OAuth tokens & TLS keys (must never be committed)
config/google_token.json
config/certs/*.key
config/certs/*.crt

# debug screenshots
screenshot_*.png
